# Streamlit Secrets Configuration Example
# 이 파일을 참고하여 secrets.toml을 작성하세요.
# .gitignore에 secrets.toml이 추가되어 있으므로 Git에 커밋되지 않습니다.

# ===== Supabase Configuration =====
# Supabase 프로젝트의 API 설정값을 입력합니다.

supabase_url = "YOUR_SUPABASE_URL"
# 예: "https://xxxxxxxxxxxxx.supabase.co"

supabase_key = "YOUR_SUPABASE_ANON_KEY"
# 예: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3M..."

# ===== 설정 방법 =====
# 1. Supabase 대시보드에서 프로젝트 설정으로 이동
# 2. "API" 탭에서 다음 정보를 복사:
#    - Project URL → supabase_url
#    - anon/public key → supabase_key
# 3. 이 파일을 "secrets.toml"으로 저장
# 4. .streamlit/ 디렉토리에 배치

# ===== 주의사항 =====
# ⚠️ secrets.toml은 절대 Git에 커밋하면 안 됩니다!
# .gitignore에 이미 추가되어 있으므로 자동으로 제외됩니다.

# ===== 로컬 개발 =====
# Streamlit은 실행 시 자동으로 .streamlit/secrets.toml을 읽습니다:
# streamlit run sales_dashboard.py

# ===== 배포 환경 =====
# Streamlit Cloud: 앱 설정 → Secrets에 위 내용 입력
# Heroku/Docker: 환경변수로 설정
#   export SUPABASE_URL="..."
#   export SUPABASE_KEY="..."
